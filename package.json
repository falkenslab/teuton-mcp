{
  "name": "@falkenslab/teuton-mcp",
  "version": "0.0.0",
  "description": "Teuton for AI agents: write, check and run infrastructure tests and read the results, through MCP.",
  "license": "MIT",
  "author": "Falken's Lab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkenslab/teuton-mcp.git"
  },
  "homepage": "https://falkenslab.github.io/teuton-mcp/",
  "bugs": {
    "url": "https://github.com/falkenslab/teuton-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-kit"
  ],
  "type": "module",
  "bin": {
    "teuton-mcp": "dist/server.mjs"
  },
  "files": [
    "dist/server.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check-tools.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "zod": "^4.6.5"
  }
}
